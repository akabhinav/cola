# COLA Agent Platform - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# AI Configuration
# ============================================

# Anthropic Claude API Key (Required)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API Key (Optional - for fallback)
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# Security
# ============================================

# JWT Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-change-this

# ============================================
# Database (for production)
# ============================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cola_db
DB_USERNAME=cola_user
DB_PASSWORD=strong-password-here

# ============================================
# Application
# ============================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# ============================================
# Storage
# ============================================

STORAGE_TYPE=local
STORAGE_PATH=./cola-projects

# For S3 storage (optional)
# STORAGE_TYPE=s3
# S3_BUCKET=cola-projects-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# Docker Registry (for deployments)
# ============================================

DOCKER_REGISTRY=localhost:5000

# ============================================
# Kubernetes (optional)
# ============================================

KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=cola-deployments

# ============================================
# Redis (for caching)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RAG (Retrieval-Augmented Generation)
# ============================================

# Vector Database Provider (pinecone, weaviate, or local)
VECTOR_DB_PROVIDER=pinecone

# Pinecone Configuration (for production RAG)
# Sign up at https://www.pinecone.io/ for free tier
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX=cola-code-index

# Local Vector DB (for development without Pinecone)
# LOCAL_VECTOR_DB_PATH=./vector-db

# ============================================
# Monitoring (optional)
# ============================================

GRAFANA_PASSWORD=secure-grafana-password
