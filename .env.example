# COLA Agent Platform - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# AI Configuration
# ============================================

# Anthropic Claude API Key (Required)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API Key (Optional - for fallback)
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# Security
# ============================================

# JWT Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-change-this

# ============================================
# Database (for production)
# ============================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cola_db
DB_USERNAME=cola_user
DB_PASSWORD=strong-password-here

# ============================================
# Application
# ============================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# ============================================
# Storage
# ============================================

STORAGE_TYPE=local
STORAGE_PATH=./cola-projects

# For S3 storage (optional)
# STORAGE_TYPE=s3
# S3_BUCKET=cola-projects-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# Docker Registry (for deployments)
# ============================================

DOCKER_REGISTRY=localhost:5000

# ============================================
# Kubernetes (optional)
# ============================================

KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=cola-deployments

# ============================================
# Monitoring (optional)
# ============================================

GRAFANA_PASSWORD=secure-grafana-password
